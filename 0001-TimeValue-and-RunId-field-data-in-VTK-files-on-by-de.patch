From ea31be7d80eacc6965579e3e6e50deee39957f12 Mon Sep 17 00:00:00 2001
From: Hans Bihs <hans.bihs@gmail.com>
Date: Sat, 3 Oct 2026 21:38:00 +0200
Subject: [PATCH 1/2] TimeValue and RunId field data in VTK files, on by
 default (P 16 1)

vtp3D, vtu3D, vts3D and vtr3D write the simulation time (TimeValue, which
ParaView shows as the file's time) and, with the run log, the run id
(RunId, a VTK string array) into every piece and parallel file. P 16 is now
1 by default; P 16 0 turns it off. TimeValue is written with 15 digits.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013aJaRBweadkc883UkvkqYs
---
 src/ini.cpp   |  2 +-
 src/vtk3D.h   | 18 +++++++++++++++++-
 src/vtp3D.cpp |  5 +++--
 src/vtr3D.cpp |  5 +++--
 src/vts3D.cpp |  5 +++--
 src/vtu3D.cpp |  5 +++--
 6 files changed, 30 insertions(+), 10 deletions(-)

diff --git a/src/ini.cpp b/src/ini.cpp
index 07412157f..3394e4fb6 100644
--- a/src/ini.cpp
+++ b/src/ini.cpp
@@ -731,7 +731,7 @@ void control::ini_default()
     P11=10;			 // int log print frequency
 	P12=1;			 // int terminal print frequency
 	P15=1;          // int print file numbering
-    P16=0;          // int add timestamp to paraview files
+    P16=1;          // int add timestamp (and run id) to paraview files
     P19=2;          // int print NHFLOW floating  based on vtp or vtu interval
 	P20=-10;		// ith iteration file printed
     P21=0;          // int time averaged vtu print out
diff --git a/src/vtk3D.h b/src/vtk3D.h
index 6247e420e..240fe984f 100644
--- a/src/vtk3D.h
+++ b/src/vtk3D.h
@@ -26,6 +26,7 @@ Author: Alexander Hanke
 #include <ostream>
 #include <sstream>
 #include <vector>
+#include <string>
 #include <cstring>
 #include <iomanip>
 
@@ -58,7 +59,22 @@ class vtk3D
     protected:
         void xmlVersion(std::ostream &result) {result<<"<?xml version=\"1.0\"?>\n";};
         void vtkVersion(std::ostream &result) {result<<"version=\"1.0\" byte_order=\"LittleEndian\">\n";}; // header_type=\"UInt32\"
-        void timeValue(std::ostream &result, const double time) {result<<"<FieldData>\n<DataArray type=\"Float64\" Name=\"TimeValue\" NumberOfTuples=\"1\"> "<<std::setprecision(7)<<time<<"\n</DataArray>\n</FieldData>\n";};
+        // field data: the simulation time (ParaView reads TimeValue as the time of the
+        // file) and, with a run log, the run that wrote it (LAGOON RUN.md). VTK writes
+        // ASCII strings as their character codes, each string ending in 0.
+        void timeValue(std::ostream &result, const double time, const std::string &run_id=std::string())
+        {
+            result<<"<FieldData>\n<DataArray type=\"Float64\" Name=\"TimeValue\" NumberOfTuples=\"1\" format=\"ascii\"> "
+                  <<std::setprecision(15)<<time<<"\n</DataArray>\n";
+            if(!run_id.empty())
+            {
+                result<<"<DataArray type=\"String\" Name=\"RunId\" NumberOfTuples=\"1\" format=\"ascii\">";
+                for(unsigned char c : run_id)
+                result<<" "<<int(c);
+                result<<" 0\n</DataArray>\n";
+            }
+            result<<"</FieldData>\n";
+        };
         void appendData(std::ostream &result) {result<<"<AppendedData encoding=\"raw\">\n_";};
         void structureWriteEnd(std::vector<char> &buffer, size_t &m) {
             std::stringstream result;
