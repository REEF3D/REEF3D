+
+                any = true;
+                const double ax=sx[0], ay=sy[0], bx=sx[1], by=sy[1];
+                const double ex=bx-ax, ey=by-ay;
+                const double ll = ex*ex + ey*ey;
+                const double ylo = MIN(ay,by), yhi = MAX(ay,by);
+
+                for(int ii=i0; ii<i1; ++ii)
