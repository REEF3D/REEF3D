+                    const double dq = Z[m]-z0, dr = Z[r]-z0;
+                    if((dq<0.0 && dr>=0.0) || (dq>=0.0 && dr<0.0))
+                    {
+                        const double t = dq/(dq-dr);
+                        sx[ns] = X[m] + t*(X[r]-X[m]);
+                        sy[ns] = Y[m] + t*(Y[r]-Y[m]);
+                        ++ns;
+                    }
+                }
+                if(ns<2)
