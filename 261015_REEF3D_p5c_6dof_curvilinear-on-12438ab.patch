index 0000000..00864fe
--- /dev/null
+++ b/src/6DOF_obj_ray2D_curv.cpp
@@ -0,0 +1,195 @@
+/*--------------------------------------------------------------------
+REEF3D
+Copyright 2008-2026 Hans Bihs
+
