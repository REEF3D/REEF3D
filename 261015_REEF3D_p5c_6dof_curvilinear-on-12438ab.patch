+                if(x<xs || x>xe || y<ys || y>ye)
+                continue;
+
+                double Px = x-psi, Py = y+psi;
+                double u = ((By-Cy)*(Px-Cx) + (Cx-Bx)*(Py-Cy))/d;
+                double v = ((Cy-Ay)*(Px-Cx) + (Ax-Cx)*(Py-Cy))/d;
+                double w = 1.0-u-v;
+
+                if(u>0.0 && v>0.0 && w>0.0)
+                {
+                    double Rz = u*Az + v*Bz + w*Cz;
+                    if(p0->wd-Rz>0.0)
+                    s->draft(ii,jj) = MAX(p0->wd-Rz,s->draft(ii,jj));
+                }
+            }
+        }
+    }
