+    
+    double cum=0.0;
+    for(int q=0;q<p->S51;++q)
+    {
+        cum += MAX(p->S51_fa[q],0.0)/sum;
+        
+        if(u<cum)
+        return p->S51_d[q];
+    }
+    
+    return p->S51_d[p->S51-1];
+}
