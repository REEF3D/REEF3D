# box barge with propeller (sampled inflow) and MMG rudder, zig-zag steering
form_factor 0.1
crossflow 0.8
strips 20
propeller -0.6 0.0 -0.07 0.12
propeller_kt 0.33 -0.25 -0.08
propeller_kq 0.045 -0.03 -0.01
propeller_rps 6.0
propeller_inflow sample 0.1
rudder -0.72 -0.07 0.012 1.5
rudder_angle zigzag 20 0.02
rudder_rate 200
