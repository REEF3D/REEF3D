@@ -183,9 +183,10 @@ void etimestep::start(fdm *a, lexer *p, ghostcell *pgc, turbulence *pturb)
     
     cu = MIN3(cu,cv,cw);
 
+    // minimum over all ranks (was the value of rank 0, i.e. of its cells only)
+    cu = pgc->globalmin(cu);
+
 	p->dt=p->N47*cu;
-    
-	p->dt=pgc->timesync(p->dt);
    // p->dt = MIN(p->dt,10.0*p->dt_old);
     p->dt_old=p->dt;
     
@@ -263,6 +264,7 @@ void etimestep::ini(fdm* a, lexer* p,ghostcell* pgc)
 	visccrit=(p->viscmax*(6.0/pow(p->DXM,2.0)));
 
 	dx = p->DXM;
+    cu = 1.0e10;
     
     LOOP
     {
@@ -272,8 +274,9 @@ void etimestep::ini(fdm* a, lexer* p,ghostcell* pgc)
     
             + sqrt((4.0*fabs(MAX3(a->maxF,a->maxG,a->maxH)))/dx)));
