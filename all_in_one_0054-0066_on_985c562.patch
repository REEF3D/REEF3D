From 5f914956568806fc0c5985fe9f3b9d92072159ab Mon Sep 17 00:00:00 2001
From: Hans Bihs <hans.bihs@ntnu.no>
Date: Sun, 4 Oct 2026 00:02:05 +0200
Subject: [PATCH 07/13] solid forcing: no halo exchange of the zeroed fbh and
 of fx/fy/fz

ghostcell::solid_forcing zeroed fbh1..4, exchanged their halos (start1..4),
built fbh from the interior values and exchanged the halos again at the end;
then it exchanged fx/fy/fz. The first exchange is overwritten by the final
one (fbh is only read at (i,j,k) while it is built), and the fx/fy/fz
halos are not used (only the interior is applied to the velocities,
see momentum_forcing_start). 7 of 11 start calls per RK stage removed.

Bitwise identical (regression 34/34, validation 30/30).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0114EoYH2J5n8x9czzdi2yNp
---
 src/gc_solid_forcing.cpp | 10 +++-------
 1 file changed, 3 insertions(+), 7 deletions(-)

diff --git a/src/gc_solid_forcing.cpp b/src/gc_solid_forcing.cpp
index 142e03e3f..cce5f64a7 100644
--- a/src/gc_solid_forcing.cpp
+++ b/src/gc_solid_forcing.cpp
@@ -41,10 +41,8 @@ void ghostcell::solid_forcing(lexer *p, fdm *a, double alpha, field& uvel, field
     LOOP
     a->fbh4(i,j,k) = 0.0;
 
-    start1(p,a->fbh1,10);
-    start2(p,a->fbh2,11);
-    start3(p,a->fbh3,12);
-    start4(p,a->fbh4,40);
+    // no halo update of the zeroed fields: fbh is built from the interior values below,
+    // the halos are set once at the end
 
 // Calculate forcing fields
     double H,Ht, uf, vf, wf;
@@ -439,8 +437,6 @@ void ghostcell::solid_forcing(lexer *p, fdm *a, double alpha, field& uvel, field
     start3(p,a->fbh3,12);
     start4(p,a->fbh4,40);
 
-    start1(p,fx,10);
-    start2(p,fy,11);
-    start3(p,fz,12);         
+    // fx/fy/fz: only the interior is applied to the velocities (momentum_forcing_start)
 }
 
-- 
