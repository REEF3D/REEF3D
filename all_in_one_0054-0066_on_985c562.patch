+            vof_nte(p,p->F80>0),vof_ntw(p,p->F80>0),vof_nbe(p,p->F80>0),vof_nbw(p,p->F80>0),vof_ste(p,p->F80>0),vof_stw(p,p->F80>0),vof_sbe(p,p->F80>0),vof_sbw(p,p->F80>0),
