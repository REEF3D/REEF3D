+
+#ifndef FNPF_ICE_H_
+#define FNPF_ICE_H_
+
+#include"increment.h"
+#include"slice4.h"
+#include"fnpf_ice_floe.h"
+#include<vector>
+#include<array>
+#include<fstream>
+#include<mpi.h>
