+{
+    state_in in{v, k};
+    in.vd(t_);
+    in.list(s_, [&](std::vector<body_snapshot> &b)
+    {
+        in.list(b, [&](body_snapshot &s){in.m(s.x); in.m(s.v); in.m(s.a); in.m(s.R); in.m(s.w); in.m(s.alpha);});
