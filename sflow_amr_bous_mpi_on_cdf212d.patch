+// Boussinesq u_a on the level-l patches: the line systems of each patch take u_a around the patch
+// as boundary values.  Where a patch borders a sibling or is cut at a partition edge, these are the
+// neighbour's new values: the solve is repeated with the exchanged u_a (overlapping Schwarz, the
+// overlap being the EXT computed cells on either side) until they no longer change, so that the
+// result does not depend on how the level is split into patches and ranks.  The computed cells
+// beyond the patch take the rows of the neighbour first (fill_rows): their own rows come from the
+// state computed there, which is inexact towards the end of the band, and two different rows for
+// one cell leave the iteration without a fixed point.  At the coarse-fine edges the boundary
+// values are the interpolated u_a of the coarser level.
+void sflow_amr::bous_couple(ghostcell *pgc, int l)
+{
+    const int itmax = 50;
+    const double rtol = 1.0e-10;
+
+    auto solve = [&]()
+    {
+        comms_off guard(pgc);
+        for(int n : lev[l])
+        P[n]->pmom->bous_solve(P[n]->pp,P[n]->b,pgc);
+    };
+
+    fill_rows(l);
+    solve();
+
+    // scale: largest |u_a| of the level
+    double umax=0.0;
+    for(int n : lev[l])
+    {
+        sflow_amr_patch *c = P[n];
+        for(int ii=EXT; ii<EXT+c->nx; ++ii)
+        for(int jj=EXT; jj<EXT+c->ny; ++jj)
+        umax = MAX(umax,MAX(fabs(c->b->UA(ii,jj)),fabs(c->b->VA(ii,jj))));
+    }
+    MPI_Allreduce(MPI_IN_PLACE,&umax,1,MPI_DOUBLE,MPI_MAX,MPI_COMM_WORLD);
+
+    int it=1;
+    while(fill_ua(l) > rtol*MAX(umax,1.0e-12) && it<itmax)
+    {
+        solve();
+        ++it;
+    }
+
+    bq_it_total += it;
+    ++bq_solves;
+}
+
+// rows of the u_a, v_a line systems of the sibling (kind 0) and remote (kind 2) cells around the
+// level-l patches, from the patch that owns the cell
+void sflow_amr::fill_rows(int l)
+{
+    const int NR = 9;
+    sflow_amr_xplan &X = gplan[l];
+
+    auto rows = [&](const sflow_amr_fill &f, double *r)
+    {
+        r[0] = -1.0;
+        if(f.kind!=0 || f.g<0)
+        return;
+        sflow_boussinesq *q = P[f.g]->pmom->boussinesq();
+        const int a=f.si, c=f.sj;
+        r[0] = 1.0;
+        r[1] = q->Xp(a,c); r[2] = q->Xn(a,c); r[3] = q->Xs(a,c); r[4] = q->Xr(a,c);
+        r[5] = q->Yp(a,c); r[6] = q->Ye(a,c); r[7] = q->Yw(a,c); r[8] = q->Yr(a,c);
+    };
+
+    for(size_t k=0; k<X.speer.size(); ++k)
+    {
+        vector<double> &sb = X.sbuf[k];
+        sb.resize(X.sitem[k].size()*NR);
+        for(size_t m=0; m<X.sitem[k].size(); ++m)
+        rows(gserve[l][X.sitem[k][m]],&sb[m*NR]);
+    }
+
+    xrun(X,NR,7400+l);
+
+    double r[NR];
+    for(int n : lev[l])
+    {
+        sflow_amr_patch *c = P[n];
+        sflow_boussinesq *q = c->pmom->boussinesq();
+        for(auto &f : c->fill)
+        {
+            const double *w;
+            if(f.kind==2)
+            w = &X.rbuf[f.si][(size_t)f.slot*NR];
+            else if(f.kind==0)
+            {
+                rows(f,r);
+                w = r;
+            }
+            else
+            continue;
+
+            if(w[0]<0.0)
+            continue;
+
+            const int a=f.di, d=f.dj;
+            q->Xp(a,d) = w[1]; q->Xn(a,d) = w[2]; q->Xs(a,d) = w[3]; q->Xr(a,d) = w[4];
+            q->Yp(a,d) = w[5]; q->Ye(a,d) = w[6]; q->Yw(a,d) = w[7]; q->Yr(a,d) = w[8];
+        }
+    }
+}
+
+// u_a, v_a of the sibling (kind 0) and remote (kind 2) cells around the level-l patches;
+// returns the largest change (all ranks)
+double sflow_amr::fill_ua(int l)
+{
+    sflow_amr_xplan &X = gplan[l];
+    double v[NVMAX];
+
+    auto ua = [&](const sflow_amr_fill &f, double &u, double &w)
+    {
+        if(f.kind==0)
+        {
+            gh G = grid(f.g);
+            u = G.b->UA(f.si,f.sj);
+            w = G.b->VA(f.si,f.sj);
+            return;
+        }
+        if(f.kind==1)
+        {
+            eval_fill(f,v);
+            u = v[10];
+            w = v[11];
+            return;
+        }
+        u = w = 0.0;
+    };
+
+    for(size_t k=0; k<X.speer.size(); ++k)
+    {
+        vector<double> &sb = X.sbuf[k];
+        sb.resize(X.sitem[k].size()*2);
+        for(size_t m=0; m<X.sitem[k].size(); ++m)
+        ua(gserve[l][X.sitem[k][m]],sb[m*2],sb[m*2+1]);
+    }
+
+    xrun(X,2,7300+l);
+
+    double d=0.0;
+    for(int n : lev[l])
+    {
+        sflow_amr_patch *c = P[n];
+        fdm2D *b = c->b;
+        for(auto &f : c->fill)
+        {
+            double u,w;
+            if(f.kind==2)
+            {
+                u = X.rbuf[f.si][(size_t)f.slot*2];
+                w = X.rbuf[f.si][(size_t)f.slot*2+1];
+            }
+            else if(f.kind==0)
+            ua(f,u,w);
+            else
+            continue;
+
+            // convergence on the boundary values of the solve (cells outside the computed ones);
+            // the computed cells beyond the patch keep the patch's own solution after the solve,
+            // which differs from the owner's where both reach into an unrefined gap
+            if(f.di<0 || f.di>=c->pp->knox || f.dj<0 || f.dj>=c->pp->knoy)
+            d = MAX(d,MAX(fabs(u-b->UA(f.di,f.dj)),fabs(w-b->VA(f.di,f.dj))));
+            b->UA(f.di,f.dj) = u;
+            b->VA(f.di,f.dj) = w;
+        }
+    }
+
+    MPI_Allreduce(MPI_IN_PLACE,&d,1,MPI_DOUBLE,MPI_MAX,MPI_COMM_WORLD);
+    return d;
+}
