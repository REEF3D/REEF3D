++void nhflow_print_timeavg_wsfline::sort(double *a, double *b, int *c, int left, int right)
++{
++    if (left < right)
++    {
++        double pivot = a[right];
++        int l = left;
++        int r = right;
++
++        do {
++            while (a[l] < pivot) l++;
++            while (a[r] > pivot) r--;
++
++            if (l <= r) {
++                double swap = a[l];
++                double swapd = b[l];
++                int swapc = c[l];
++
++                a[l] = a[r];
++                a[r] = swap;
++
++                b[l] = b[r];
++                b[r] = swapd;
++
++                c[l] = c[r];
++                c[r] = swapc;
++
++                l++;
++                r--;
++            }
++        } while (l <= r);
++
++        sort(a,b,c, left, r);
++        sort(a,b,c, l, right);
++    }
