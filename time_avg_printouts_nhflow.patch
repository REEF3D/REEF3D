++        int r = right;
++
++        do {
++            while (a[l] < pivot) l++;
++            while (a[r] > pivot) r--;
++
++            if (l <= r) {
++                double swap = a[l];
++                double swapd = b[l];
++                int swapc = c[l];
++
++                a[l] = a[r];
